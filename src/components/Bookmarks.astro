---
import {
  generateSlug,
  normalizeUrl,
  parseStoredBookmarks,
  type Bookmark,
} from '../lib/bookmarks';
---
<form id="add-bookmark">
  <div class="field">
    <label for="url">Link to save</label>
    <input
      id="url"
      name="url"
      type="text"
      inputmode="url"
      autocomplete="off"
      spellcheck="false"
      placeholder="https://example.com"
      required
    />
  </div>
  <button type="submit">Add bookmark</button>
</form>

<p class="hint">Paste a URL and select <strong>Add bookmark</strong> to generate its short <code>mona-</code> slug.</p>

<p id="empty-state" class="empty">No bookmarks yet — add your first link above.</p>

<div id="list-header" hidden>
  <h2 class="list-title">Saved bookmarks</h2>
  <button id="clear-all" type="button" class="clear">Clear all</button>
</div>

<ul id="bookmark-list" aria-label="Saved bookmarks" aria-live="polite">
  <!-- Bookmarks render here in the browser. -->
</ul>

<script>
  // CLIENT-SIDE BOUNDARY — runs in the browser only.
  const storageKey = 'mona-bookmarks';
  const form = document.getElementById('add-bookmark');
  const input = document.getElementById('url');
  const list = document.getElementById('bookmark-list');
  const emptyState = document.getElementById('empty-state');
  const listHeader = document.getElementById('list-header');
  const clearAll = document.getElementById('clear-all');

  if (
    form instanceof HTMLFormElement &&
    input instanceof HTMLInputElement &&
    list instanceof HTMLUListElement &&
    emptyState instanceof HTMLElement &&
    listHeader instanceof HTMLElement &&
    clearAll instanceof HTMLButtonElement
  ) {
    const readStorage = () => {
      try {
        return parseStoredBookmarks(localStorage.getItem(storageKey));
      } catch {
        return [];
      }
    };

    let bookmarks = readStorage();

    const save = () => {
      try {
        localStorage.setItem(storageKey, JSON.stringify(bookmarks));
      } catch {
        // Rendering remains usable when browser storage is unavailable.
      }
    };

    const render = () => {
      list.replaceChildren();
      emptyState.hidden = bookmarks.length > 0;
      listHeader.hidden = bookmarks.length === 0;

      for (const bookmark of bookmarks) {
        const row = document.createElement('li');
        row.className = 'bookmark';

        const link = document.createElement('a');
        link.className = 'url';
        link.href = bookmark.url;
        link.target = '_blank';
        link.rel = 'noopener noreferrer';
        link.textContent = bookmark.url;

        const separator = document.createElement('span');
        separator.className = 'bookmark-separator';
        separator.textContent = ' :: ';

        const slug = document.createElement('code');
        slug.className = 'slug';
        slug.textContent = bookmark.slug;

        const copy = document.createElement('button');
        copy.className = 'copy';
        copy.type = 'button';
        copy.textContent = 'Copy';
        copy.addEventListener('click', async () => {
          try {
            await navigator.clipboard.writeText(bookmark.slug);
            copy.textContent = 'Copied';
            window.setTimeout(() => {
              copy.textContent = 'Copy';
            }, 1200);
          } catch {
            copy.textContent = 'Copy failed';
          }
        });

        row.append(link, separator, slug, copy);
        list.append(row);
      }
    };

    form.addEventListener('submit', (event) => {
      event.preventDefault();
      const url = normalizeUrl(input.value);
      if (!url) {
        input.setCustomValidity('Enter a valid URL.');
        input.reportValidity();
        return;
      }

      input.setCustomValidity('');
      const bookmark: Bookmark = {
        url,
        slug: generateSlug(bookmarks.map((item) => item.slug)),
      };
      bookmarks = [...bookmarks, bookmark];
      save();
      render();
      form.reset();
      input.focus();
    });

    clearAll.addEventListener('click', () => {
      if (!bookmarks.length || !window.confirm('Clear all saved bookmarks?')) return;
      bookmarks = [];
      try {
        localStorage.removeItem(storageKey);
      } catch {
        // Keep the in-memory list cleared when browser storage is unavailable.
      }
      render();
    });

    render();
  }
</script>
